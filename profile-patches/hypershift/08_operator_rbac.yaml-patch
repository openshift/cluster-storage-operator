# Remove include.release.openshift.io/* annotations from standalone version
# Add HyperShift-specific annotation so CVO includes this manifest in HyperShift deployments
- op: remove
  path: /metadata/annotations/include.release.openshift.io~1self-managed-high-availability
- op: remove
  path: /metadata/annotations/include.release.openshift.io~1single-node-developer
- op: remove
  path: /metadata/annotations/include.release.openshift.io~1ibm-cloud-managed
- op: add
  path: /metadata/annotations/include.release.openshift.io~1hypershift
  value: "true"
